rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids
      );
    }

    // =========================================================================
    // 1. USER PROFILES & PRIVATE PERSONAL WALLETS (100% PRIVATE TO EACH PERSON)
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All private subcollections (personalBackup, personalAccounts, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================================================================
    // 2. INVITE CODES (SECURE HOUSEHOLD JOINING CODES)
    // =========================================================================
    match /invites/{code} {
      // Explicitly block listing / queries to prevent scraping or brute-force dumps
      allow list: if false;

      // Allow direct document lookup only when knowing the exact code
      allow get: if isAuthenticated();

      // Only household members can create or delete their household's invite code
      allow create: if isAuthenticated() && isHouseholdMember(request.resource.data.householdId);
      allow delete: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow update: if false;
    }

    // =========================================================================
    // 3. HOUSEHOLDS & SHARED DATA (MEMBERS, TASKS, SHOPPING & OUR WALLET)
    // =========================================================================
    match /households/{householdId} {
      // Strictly forbid listing households - prevents enumerating all families
      allow list: if false;

      // Only confirmed household members can read household document
      allow get: if isAuthenticated() && (
        request.auth.uid in resource.data.memberUids
      );
      
      // Creating a new household requires creator uid to be in memberUids
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberUids;
      
      // Updating household:
      // Option A: Existing members can update household metadata/budget
      // Option B: Joining member may only append their own UID to memberUids while verifying invite exists
      allow update: if isHouseholdMember(householdId) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids &&
        exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode))
      );

      // All shared subcollections (members, tasks, checklist, shopping, items, purchases, moneyCategories, accounts, transactions)
      match /{subcollection}/{docId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
