rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids
      );
    }

    // =========================================================================
    // 1. USER PROFILES & PRIVATE PERSONAL WALLETS (100% PRIVATE TO EACH PERSON)
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All private subcollections (personalAccounts, personalTransactions, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================================================================
    // 2. HOUSEHOLDS & SHARED DATA (MEMBERS, TASKS, SHOPPING & OUR WALLET)
    // =========================================================================
    match /households/{householdId} {
      // Anyone authenticated can read household metadata to join via invite code
      allow read: if isAuthenticated();
      
      // Creating a new household requires creator uid to be in memberUids
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberUids;
      
      // Updating household: existing members can update, or a new user joining adds their uid
      allow update: if isHouseholdMember(householdId) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
        request.auth.uid in request.resource.data.memberUids
      );

      // All shared subcollections (members, tasks, checklist, shopping, items, purchases, moneyCategories, accounts, transactions)
      match /{subcollection}/{docId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
